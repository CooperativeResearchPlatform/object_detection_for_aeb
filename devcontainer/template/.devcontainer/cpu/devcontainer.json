{
    "name": "MMDetection3D CPU - data preparation",
    "build": {
        "dockerfile": "../Dockerfile.cpu",
        "context": ".."
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/mmdetection3d,type=bind",
    "workspaceFolder": "/workspace/mmdetection3d",
    "runArgs": [
        "--shm-size=8g"
    ],
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "containerEnv": {
        "MPLCONFIGDIR": "/tmp/matplotlib-cache",
        "MMDET3D_DEVICE": "cpu",
        "PYTHONPATH": "/workspace/mmdetection3d",
        "PYTHONUNBUFFERED": "1"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/mmdet3d-venv/bin/python",
                "python.terminal.activateEnvironment": false
            }
        }
    }
}