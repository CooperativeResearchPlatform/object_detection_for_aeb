<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception</name>
  <version>0.1.0</version>
  <description>LiDAR alapú CenterPoint objektumdetekció (ONNX Runtime) és akadály-/fékdöntés</description>

  <maintainer email="todo@todo.todo">team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>crp_msgs</depend>
  <depend>std_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- ONNX Runtime: nem rosdep csomag, kézzel kell telepíteni (lásd README / CMakeLists.txt) -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
